<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="코레일 예매 매크로"
                android:textStyle="bold"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/buttonSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="⚙"
                android:textSize="24sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="예매 조건"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <EditText
                android:id="@+id/editDepStation"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="출발역 선택"
                android:inputType="none"
                android:focusable="false"
                android:cursorVisible="false"
                android:clickable="true" />

            <EditText
                android:id="@+id/editArrStation"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:hint="도착역 선택"
                android:inputType="none"
                android:focusable="false"
                android:cursorVisible="false"
                android:clickable="true" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonPickDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="날짜 · 시작시각 선택" />

        <TextView
            android:id="@+id/textSelectedDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="선택된 날짜 없음" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:weightSum="2">

            <EditText
                android:id="@+id/editStartTime"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="시작시각 선택"
                android:inputType="none"
                android:focusable="false"
                android:cursorVisible="false"
                android:clickable="true" />

            <EditText
                android:id="@+id/editEndTime"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:hint="종료시각 선택(선택안함 가능)"
                android:inputType="none"
                android:focusable="false"
                android:cursorVisible="false"
                android:clickable="true" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="열차 종류"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbKtx"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="KTX"
                android:checked="true" />

            <CheckBox
                android:id="@+id/cbItxSaemaeul"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="ITX/새마을"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbMugunghwa"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="무궁화호"
                android:checked="true" />

            <CheckBox
                android:id="@+id/cbItxCheongchun"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="ITX-청춘"
                android:checked="true" />
        </LinearLayout>

        <EditText
            android:id="@+id/editAdultCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="인원수 선택"
            android:inputType="none"
            android:focusable="false"
            android:cursorVisible="false"
            android:clickable="true" />

        <RadioGroup
            android:id="@+id/radioGroupSeatType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbGeneralSeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="일반실"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbSpecialSeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="특실" />

            <RadioButton
                android:id="@+id/rbAnySeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="일반+특실" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:weightSum="2">

            <Button
                android:id="@+id/buttonStart"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="시작" />

            <Button
                android:id="@+id/buttonStop"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="중지" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonIgnoreBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="배터리 최적화 제외 설정" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="실행 로그"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/buttonExpandLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="크게 보기"
                android:textColor="@color/colorAccent"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollLog"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="#111111"
            android:scrollbars="vertical"
            android:scrollbarStyle="insideOverlay"
            android:fadeScrollbars="false"
            android:nestedScrollingEnabled="true">

            <TextView
                android:id="@+id/textLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#00FF66"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:textSize="12sp"
                android:textIsSelectable="true"
                android:text="대기 중..." />
        </ScrollView>

    </LinearLayout>
</ScrollView>
